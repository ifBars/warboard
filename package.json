{
  "name": "warboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && bun scripts/build-offline.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test src",
    "lint": "eslint src",
    "typecheck": "tsc -b",
    "format": "prettier --write src scripts *.json *.ts *.mjs *.md",
    "maps:prepare": "bun scripts/prepare-maps.ts",
    "maps:detail": "bun scripts/prepare-detail.ts",
    "terrain:prepare": "bun scripts/prepare-terrain.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "eslint": "9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.0"
  }
}
